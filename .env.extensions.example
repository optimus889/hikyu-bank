# Copy to .env.extensions. Demo mode needs no API credentials.
HIKYU_AI_MODE=demo
HIKYU_AI_KEY=
HIKYU_AI_MODEL=
HIKYU_AI_URL=https://api.openai.com/v1/chat/completions
HIKYU_AI_TIMEOUT_SECONDS=10
HIKYU_AI_MAX_TOKENS=512
HIKYU_AI_REQUESTS_PER_MINUTE=10
HIKYU_AI_ALLOW_LOCAL_HTTP=false
# Keep false until an intended existing-database upgrade has been reviewed.
HIKYU_EXTENSION_MIGRATION_APPROVED=false
