          "raw": "{\n  \"sourceAccountId\": \"{{source_id}}\",\n  \"recipientUsername\": \"{{recipient_username}}\",\n  \"amount\": \"25.00\",\n  \"note\": \"Postman peer payment\",\n  \"idempotencyKey\": \"{{payment_key}}\",\n  \"challengeId\": \"{{peer_challenge}}\",\n  \"verificationCode\": \"{{peer_code}}\",\n  \"pin\": \"{{pin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status\", () => pm.response.to.have.status(201));",
              "pm.test(\"Same receipt\",()=>pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"payment_receipt\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "25 Payment history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Hikyu-Request",
            "value": "web"
          }
        ],
        "url": "{{base_url}}/payments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "26 Filter peer payment legs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Hikyu-Request",
            "value": "web"
          }
        ],
        "url": "{{base_url}}/transactions/search?kind=peer_transfer"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only own debit\",()=>pm.expect(pm.response.json().total).to.eql(1));"
            ]
          }
        }
      ]
    }
  ]
}
