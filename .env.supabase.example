# Copy to .env.supabase and enter YOUR EXISTING Supabase database settings.
# Keep the password separate from the URL; these are database credentials,
# not Supabase anon/service_role API keys. Do not commit .env.supabase.
# Session pooler example (use the exact host/user shown by Supabase Connect):
HIKYU_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
HIKYU_DB_USER=postgres.YOUR_PROJECT_REF
HIKYU_DB_PASSWORD=YOUR_DATABASE_PASSWORD
# Direct connection also works if your network supports its address.
# Alternative: omit HIKYU_DB_URL and set SUPABASE_DB_HOST, SUPABASE_DB_PORT,
# SUPABASE_DB_NAME, SUPABASE_DB_USER, SUPABASE_DB_PASSWORD.
# PORT=8080

# Enable only after reviewing the UUID migration and verifying a cloud backup.
HIKYU_UUID_MIGRATION_APPROVED=false
